[Unit]
Description=Local operation broker for the exit controller
Requires=mullvad-exit-network.service
After=mullvad-exit-network.service mullvad-exit-wireguard.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/libexec/mullvad-controller-broker.py
Group=mullvad-controller
RuntimeDirectory=mullvad-controller
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
